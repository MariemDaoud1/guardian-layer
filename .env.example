# Copy to .env (make install does this) and replace every value. Never commit .env.
# Shared with the Twin team: signs/verifies sensor envelopes.
TWIN_HMAC_KEY=change-me-twin-hmac-key
# Shared with the Brain team: signs/verifies Guardian verdicts.
GUARDIAN_HMAC_KEY=change-me-guardian-hmac-key
# One API key per partner (X-API-Key header). The key decides the caller identity.
BRAIN_API_KEY=change-me-brain-api-key
TWIN_API_KEY=change-me-twin-api-key
OPS_API_KEY=change-me-ops-api-key
# Optional overrides of config/guardian.yaml
# TWIN_BASE_URL=http://localhost:8101
# TWIN_TRANSPORT=rest
# TWIN_MODE=push
# LOG_DIR=../logs
# GUARDIAN_DB_PATH=./data/guardian.db
